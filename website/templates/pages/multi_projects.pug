extends ../layout.pug


block navbar
	a(href="#others")
		i.fa.fa-file-arrow-down(title=__("Projects"))
		span= __("Projects")
	a(href="/about")
		i.fa.fa-flag(title=__("About"))
		span= __("About")


block content
	if currentProjects.length > 0
		div.container.pb-5
			//- Project summary
			div#summary.jumbotron.py-2.px-3.pb-3.p-md-5.mb-3.text-white.rounded.bg-dark.position-relative
				img.position-absolute.pdm-project-badge(src=icon alt="" width="100")
				div.col-8.px-0.pb-1
					h1.font-italic= __("Currently: %s prioritary projects", currentProjects.length)

				div.row
					each proj in currentProjects
						include ../components/project_item.pug

	if projectsList && projectsList.length > 0
		//- Other projects
		a#others
		div.container-fluid.pb-5
			include ../components/projects_list.pug

	else if projectsStats && projectsStats.length > 0
		div.container-fluid.pb-5
			div.container.blog-post
				p(style="font-size: 80%;")= __("Statistics updated everyday out of the day before")
